#!/bin/bash

session="bminer"

TMUXPID=$(pgrep tmux)
if [ -n "$TMUXPID" ]; then
    echo -e "\033[0;31mWARNING\033[0m: bminer is running!!!"
    tmux  -2 attach-session -t $session
    exit 0
fi

# set up tmux  server
tmux  start-server

# create a new tmux  session, starting vim from a saved session in the new window
tmux  new-session -d -s $session -n Command "/bin/bash -l" # windows name: Command

tmux  selectp -t 0
tmux  splitw -h -p 50
tmux  splitw -v -p 50

tmux respawn-pane -t ${session}:0.1 -k "/opt/bminer/gpu_monitor.sh"
tmux respawn-pane -t ${session}:0.2 -k "/opt/bminer/miner_monitor.sh"

# Select pane 0
tmux  selectp -t 0

# return to main vim window
tmux  select-window -t $session:0

# Finished setup, attach to the tmux  session!
tmux  -2 attach-session -t $session
